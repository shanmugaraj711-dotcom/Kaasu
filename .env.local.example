# Kaasu — environment variables
# Copy to .env.local (gitignored) for local dev, or set as Vercel env vars.
# NEVER commit real values.

# OpenRouter (free tier) — first AI provider for parsing and reminder drafting.
# Without it the app tries Groq next, then falls back to deterministic rules/templates and says so.
OPENROUTER_API_KEY=

# Groq (free tier, no card) — second AI provider, tried when OpenRouter fails or is unset.
# Get a key at console.groq.com (free). Without it: rules/template fallback.
GROQ_API_KEY=

# PayPal sandbox — required for real invoices.
# Without them the app runs in clearly-labelled DEMO (mock) mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX (default) or PRODUCTION — keep SANDBOX for the hackathon.
PAYPAL_ENVIRONMENT=SANDBOX
# Merchant email shown on invoices (sandbox business account email).
PAYPAL_MERCHANT_EMAIL=support@promptstudioai.in
# Webhook ID from developer.paypal.com (webhooks) — needed to verify
# INVOICING.INVOICE.PAID signatures. Until set, polling covers payment status.
PAYPAL_WEBHOOK_ID=
